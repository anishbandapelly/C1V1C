# C1V1C AWS configuration — Hyderabad. Safe public values only.
# Copy this file to .env for local non-secret settings (the .env file is ignored by Git).
# AWS credentials are intentionally NOT stored here. Use an AWS profile/role or the
# hosting provider's secret environment-variable settings for freshly rotated credentials.
AWS_REGION=ap-south-2
S3_BUCKET=amzn-c1v1-bucket-515820372090-ap-south-2-an
S3_CURATED_PREFIX=input/curated/
S3_RUNS_PREFIX=runs/
# Leave unset until a real invoke succeeds in the correct Region/profile.
BEDROCK_MODEL_ID=
# Stay offline while Bedrock access/account verification is incomplete.
C1V1C_OFFLINE_MODE=true
C1V1C_BASELINE_VERSION=synthetic_v1
C1V1C_MODEL_VERSION=not_implemented
